{
  "$schema": "vscode://schemas/color-theme",
  "name": "Apple System Colors Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#000000",
    "focusBorder": "#0069d3",
    "selection.background": "#abd8ff",
    "descriptionForeground": "#464646",
    "errorForeground": "#dc291e",
    "icon.foreground": "#464646",
    "widget.border": "#d1d1d6",
    "widget.shadow": "#00000020",
    "textLink.foreground": "#0069d3",
    "textLink.activeForeground": "#0069d3",
    "textPreformat.foreground": "#287ea1",
    "textBlockQuote.background": "#f2f2f7",
    "textCodeBlock.background": "#f2f2f7",
    "scrollbarSlider.background": "#00000000",
    "scrollbarSlider.hoverBackground": "#8e8e9370",
    "scrollbarSlider.activeBackground": "#8e8e9390",
    "titleBar.activeBackground": "#feffff",
    "titleBar.activeForeground": "#000000",
    "titleBar.inactiveBackground": "#feffff",
    "titleBar.inactiveForeground": "#464646",
    "titleBar.border": "#d1d1d6",
    "activityBar.background": "#feffff",
    "activityBar.foreground": "#000000",
    "activityBar.inactiveForeground": "#464646",
    "activityBar.border": "#d1d1d6",
    "activityBar.activeBorder": "#0069d3",
    "activityBarBadge.background": "#0073e8",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#feffff",
    "sideBar.foreground": "#000000",
    "sideBar.border": "#d1d1d6",
    "sideBarTitle.foreground": "#464646",
    "sideBarSectionHeader.background": "#feffff",
    "sideBarSectionHeader.foreground": "#000000",
    "sideBarSectionHeader.border": "#d1d1d6",
    "statusBar.background": "#feffff",
    "statusBar.foreground": "#464646",
    "statusBar.border": "#d1d1d6",
    "statusBar.noFolderBackground": "#feffff",
    "statusBar.debuggingBackground": "#8b740040",
    "statusBar.debuggingForeground": "#000000",
    "statusBarItem.hoverBackground": "#00000010",
    "statusBarItem.remoteBackground": "#0073e8",
    "statusBarItem.remoteForeground": "#ffffff",
    "panel.background": "#feffff",
    "panel.border": "#d1d1d6",
    "panelTitle.activeForeground": "#000000",
    "panelTitle.inactiveForeground": "#464646",
    "panelTitle.activeBorder": "#0069d3",
    "editorGroupHeader.tabsBackground": "#feffff",
    "editorGroupHeader.tabsBorder": "#d1d1d6",
    "editorGroup.border": "#d1d1d6",
    "tab.activeBackground": "#feffff",
    "tab.activeForeground": "#000000",
    "tab.activeBorderTop": "#0069d3",
    "tab.inactiveBackground": "#feffff",
    "tab.inactiveForeground": "#464646",
    "tab.border": "#d1d1d6",
    "tab.hoverBackground": "#00000010",
    "breadcrumb.foreground": "#464646",
    "breadcrumb.focusForeground": "#000000",
    "list.activeSelectionBackground": "#eaebeb",
    "list.activeSelectionForeground": "#000000",
    "list.inactiveSelectionBackground": "#eaebeb80",
    "list.hoverBackground": "#00000010",
    "list.focusOutline": "#0069d3",
    "list.highlightForeground": "#0069d3",
    "list.errorForeground": "#dc291e",
    "list.warningForeground": "#8b7400",
    "tree.indentGuidesStroke": "#c7c7cc",
    "input.background": "#ffffff",
    "input.foreground": "#000000",
    "input.border": "#d1d1d6",
    "input.placeholderForeground": "#464646",
    "inputOption.activeBorder": "#0069d3",
    "inputOption.activeBackground": "#0069d330",
    "dropdown.background": "#ffffff",
    "dropdown.border": "#d1d1d6",
    "button.background": "#0073e8",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#0062c5",
    "button.secondaryBackground": "#e5e5ea",
    "button.secondaryForeground": "#000000",
    "badge.background": "#0073e8",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#0069d3",
    "checkbox.background": "#ffffff",
    "checkbox.border": "#d1d1d6",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#d1d1d6",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#d1d1d6",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#d1d1d6",
    "editorSuggestWidget.selectedBackground": "#eaebeb",
    "editorSuggestWidget.highlightForeground": "#0069d3",
    "quickInput.background": "#ffffff",
    "pickerGroup.foreground": "#0069d3",
    "pickerGroup.border": "#d1d1d6",
    "menu.background": "#ffffff",
    "menu.selectionBackground": "#0073e8",
    "menu.selectionForeground": "#ffffff",
    "notifications.background": "#ffffff",
    "notifications.border": "#d1d1d6",
    "editor.background": "#feffff",
    "editor.foreground": "#000000",
    "editorCursor.foreground": "#98989d",
    "editorCursor.background": "#ffffff",
    "editor.selectionBackground": "#eaebeb",
    "editor.inactiveSelectionBackground": "#eaebeb80",
    "editor.selectionHighlightBackground": "#eaebeb80",
    "editor.wordHighlightBackground": "#eaebeb60",
    "editor.wordHighlightStrongBackground": "#eaebeb90",
    "editor.findMatchBackground": "#8b740028",
    "editor.findMatchBorder": "#8b7400",
    "editor.findMatchHighlightBackground": "#8b740018",
    "editor.findMatchHighlightBorder": "#8b740080",
    "editor.lineHighlightBackground": "#0000000a",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#aeaeb2",
    "editorLineNumber.activeForeground": "#000000",
    "editorIndentGuide.background1": "#e5e5ea",
    "editorIndentGuide.activeBackground1": "#c7c7cc",
    "editorWhitespace.foreground": "#d1d1d6",
    "editorRuler.foreground": "#e5e5ea",
    "editorBracketMatch.background": "#0069d330",
    "editorBracketMatch.border": "#00000000",
    "editorBracketHighlight.foreground1": "#0069d3",
    "editorBracketHighlight.foreground2": "#9a3bcb",
    "editorBracketHighlight.foreground3": "#287ea1",
    "editorBracketHighlight.foreground4": "#148825",
    "editorBracketHighlight.foreground5": "#8b7400",
    "editorBracketHighlight.foreground6": "#dc291e",
    "editorError.foreground": "#dc291e",
    "editorWarning.foreground": "#8b7400",
    "editorInfo.foreground": "#0069d3",
    "editorHint.foreground": "#148825",
    "editorLink.activeForeground": "#0069d3",
    "editorGutter.addedBackground": "#148825",
    "editorGutter.modifiedBackground": "#0069d3",
    "editorGutter.deletedBackground": "#dc291e",
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.errorForeground": "#dc291e",
    "editorOverviewRuler.warningForeground": "#8b7400",
    "editorOverviewRuler.findMatchForeground": "#8b7400",
    "diffEditor.insertedTextBackground": "#14882530",
    "diffEditor.removedTextBackground": "#dc291e30",
    "diffEditor.insertedLineBackground": "#14882518",
    "diffEditor.removedLineBackground": "#dc291e18",
    "gitDecoration.addedResourceForeground": "#148825",
    "gitDecoration.untrackedResourceForeground": "#148825",
    "gitDecoration.modifiedResourceForeground": "#0069d3",
    "gitDecoration.deletedResourceForeground": "#dc291e",
    "gitDecoration.conflictingResourceForeground": "#9a3bcb",
    "gitDecoration.ignoredResourceForeground": "#464646",
    "terminal.background": "#feffff",
    "terminal.foreground": "#000000",
    "terminalCursor.foreground": "#98989d",
    "terminalCursor.background": "#ffffff",
    "terminal.selectionBackground": "#abd8ff",
    "terminal.selectionForeground": "#000000",
    "terminal.ansiBlack": "#1a1a1a",
    "terminal.ansiRed": "#cc372e",
    "terminal.ansiGreen": "#26a439",
    "terminal.ansiYellow": "#cdac08",
    "terminal.ansiBlue": "#0869cb",
    "terminal.ansiMagenta": "#9647bf",
    "terminal.ansiCyan": "#479ec2",
    "terminal.ansiWhite": "#98989d",
    "terminal.ansiBrightBlack": "#464646",
    "terminal.ansiBrightRed": "#ff453a",
    "terminal.ansiBrightGreen": "#32d74b",
    "terminal.ansiBrightYellow": "#e5bc00",
    "terminal.ansiBrightBlue": "#0a84ff",
    "terminal.ansiBrightMagenta": "#bf5af2",
    "terminal.ansiBrightCyan": "#69c9f2",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#76767c"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#9a3bcb"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#287ea1"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#dc291e"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8b7400"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#287ea1"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#0069d3"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#9a3bcb"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#148825"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#0069d3"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#148825"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#0069d3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#287ea1"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#287ea1"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#148825"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#dc291e"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#0069d3"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#dc291e"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#9a3bcb",
    "string": "#000000",
    "number": "#dc291e",
    "function": "#287ea1",
    "method": "#287ea1",
    "type": "#0069d3",
    "class": "#0069d3",
    "interface": "#0069d3",
    "enum": "#0069d3",
    "enumMember": "#8b7400",
    "property": "#148825",
    "parameter": "#000000",
    "variable": "#000000",
    "variable.readonly": "#8b7400",
    "*.defaultLibrary": "#0069d3",
    "comment": "#76767c"
  }
}
