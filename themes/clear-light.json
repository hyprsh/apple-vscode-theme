{
  "$schema": "vscode://schemas/color-theme",
  "name": "Clear Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#3a4851",
    "focusBorder": "#427296",
    "selection.background": "#e5ecf1",
    "descriptionForeground": "#506573",
    "errorForeground": "#b74b3b",
    "icon.foreground": "#506573",
    "widget.border": "#dfe2e3",
    "widget.shadow": "#00000020",
    "textLink.foreground": "#427296",
    "textLink.activeForeground": "#427296",
    "textPreformat.foreground": "#22777a",
    "textBlockQuote.background": "#f7f8f8",
    "textCodeBlock.background": "#f7f8f8",
    "scrollbarSlider.background": "#00000000",
    "scrollbarSlider.hoverBackground": "#8d959a70",
    "scrollbarSlider.activeBackground": "#8d959a90",
    "titleBar.activeBackground": "#ffffff",
    "titleBar.activeForeground": "#3a4851",
    "titleBar.inactiveBackground": "#ffffff",
    "titleBar.inactiveForeground": "#506573",
    "titleBar.border": "#dfe2e3",
    "activityBar.background": "#ffffff",
    "activityBar.foreground": "#3a4851",
    "activityBar.inactiveForeground": "#506573",
    "activityBar.border": "#dfe2e3",
    "activityBar.activeBorder": "#427296",
    "activityBarBadge.background": "#1f7bbc",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#ffffff",
    "sideBar.foreground": "#3a4851",
    "sideBar.border": "#dfe2e3",
    "sideBarTitle.foreground": "#506573",
    "sideBarSectionHeader.background": "#ffffff",
    "sideBarSectionHeader.foreground": "#3a4851",
    "sideBarSectionHeader.border": "#dfe2e3",
    "statusBar.background": "#ffffff",
    "statusBar.foreground": "#506573",
    "statusBar.border": "#dfe2e3",
    "statusBar.noFolderBackground": "#ffffff",
    "statusBar.debuggingBackground": "#816a2640",
    "statusBar.debuggingForeground": "#3a4851",
    "statusBarItem.hoverBackground": "#3a485110",
    "statusBarItem.remoteBackground": "#1f7bbc",
    "statusBarItem.remoteForeground": "#ffffff",
    "panel.background": "#ffffff",
    "panel.border": "#dfe2e3",
    "panelTitle.activeForeground": "#3a4851",
    "panelTitle.inactiveForeground": "#506573",
    "panelTitle.activeBorder": "#427296",
    "editorGroupHeader.tabsBackground": "#ffffff",
    "editorGroupHeader.tabsBorder": "#dfe2e3",
    "editorGroup.border": "#dfe2e3",
    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#3a4851",
    "tab.activeBorderTop": "#427296",
    "tab.inactiveBackground": "#ffffff",
    "tab.inactiveForeground": "#506573",
    "tab.border": "#dfe2e3",
    "tab.hoverBackground": "#3a485110",
    "breadcrumb.foreground": "#506573",
    "breadcrumb.focusForeground": "#3a4851",
    "list.activeSelectionBackground": "#eff0f1",
    "list.activeSelectionForeground": "#3a4851",
    "list.inactiveSelectionBackground": "#eff0f180",
    "list.hoverBackground": "#3a485110",
    "list.focusOutline": "#427296",
    "list.highlightForeground": "#427296",
    "list.errorForeground": "#b74b3b",
    "list.warningForeground": "#816a26",
    "tree.indentGuidesStroke": "#d0d3d5",
    "input.background": "#ffffff",
    "input.foreground": "#3a4851",
    "input.border": "#dfe2e3",
    "input.placeholderForeground": "#506573",
    "inputOption.activeBorder": "#427296",
    "inputOption.activeBackground": "#42729630",
    "dropdown.background": "#ffffff",
    "dropdown.border": "#dfe2e3",
    "button.background": "#1f7bbc",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#1a69a0",
    "button.secondaryBackground": "#edefef",
    "button.secondaryForeground": "#3a4851",
    "badge.background": "#1f7bbc",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#427296",
    "checkbox.background": "#ffffff",
    "checkbox.border": "#dfe2e3",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#dfe2e3",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#dfe2e3",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#dfe2e3",
    "editorSuggestWidget.selectedBackground": "#eff0f1",
    "editorSuggestWidget.highlightForeground": "#427296",
    "quickInput.background": "#ffffff",
    "pickerGroup.foreground": "#427296",
    "pickerGroup.border": "#dfe2e3",
    "menu.background": "#ffffff",
    "menu.selectionBackground": "#1f7bbc",
    "menu.selectionForeground": "#ffffff",
    "notifications.background": "#ffffff",
    "notifications.border": "#dfe2e3",
    "editor.background": "#ffffff",
    "editor.foreground": "#3a4851",
    "editorCursor.foreground": "#919191",
    "editorCursor.background": "#ffffff",
    "editor.selectionBackground": "#eff0f1",
    "editor.inactiveSelectionBackground": "#eff0f180",
    "editor.selectionHighlightBackground": "#eff0f180",
    "editor.wordHighlightBackground": "#eff0f160",
    "editor.wordHighlightStrongBackground": "#eff0f190",
    "editor.findMatchBackground": "#ffbf0028",
    "editor.findMatchBorder": "#816a26",
    "editor.findMatchHighlightBackground": "#ffbf0018",
    "editor.findMatchHighlightBorder": "#816a2680",
    "editor.lineHighlightBackground": "#3a48510a",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#b8bdc0",
    "editorLineNumber.activeForeground": "#3a4851",
    "editorIndentGuide.background1": "#edefef",
    "editorIndentGuide.activeBackground1": "#d0d3d5",
    "editorWhitespace.foreground": "#dfe2e3",
    "editorRuler.foreground": "#edefef",
    "editorBracketMatch.background": "#0092ff1d",
    "editorBracketMatch.border": "#00000000",
    "editorBracketHighlight.foreground1": "#427296",
    "editorBracketHighlight.foreground2": "#a440bc",
    "editorBracketHighlight.foreground3": "#22777a",
    "editorBracketHighlight.foreground4": "#3e7943",
    "editorBracketHighlight.foreground5": "#816a26",
    "editorBracketHighlight.foreground6": "#b74b3b",
    "editorError.foreground": "#b74b3b",
    "editorWarning.foreground": "#816a26",
    "editorInfo.foreground": "#427296",
    "editorHint.foreground": "#3e7943",
    "editorLink.activeForeground": "#427296",
    "editorGutter.addedBackground": "#3e7943",
    "editorGutter.modifiedBackground": "#427296",
    "editorGutter.deletedBackground": "#b74b3b",
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.errorForeground": "#b74b3b",
    "editorOverviewRuler.warningForeground": "#816a26",
    "editorOverviewRuler.findMatchForeground": "#816a26",
    "diffEditor.insertedTextBackground": "#00ff162a",
    "diffEditor.removedTextBackground": "#ff21000b",
    "diffEditor.insertedLineBackground": "#00ff1618",
    "diffEditor.removedLineBackground": "#ff21000b",
    "gitDecoration.addedResourceForeground": "#3e7943",
    "gitDecoration.untrackedResourceForeground": "#3e7943",
    "gitDecoration.modifiedResourceForeground": "#427296",
    "gitDecoration.deletedResourceForeground": "#b74b3b",
    "gitDecoration.conflictingResourceForeground": "#a440bc",
    "gitDecoration.ignoredResourceForeground": "#506573",
    "terminal.background": "#ffffff",
    "terminal.foreground": "#3a4851",
    "terminalCursor.foreground": "#919191",
    "terminalCursor.background": "#ffffff",
    "terminal.selectionBackground": "#e5ecf1",
    "terminal.ansiBlack": "#2d3840",
    "terminal.ansiRed": "#b45648",
    "terminal.ansiGreen": "#3e7943",
    "terminal.ansiYellow": "#816a26",
    "terminal.ansiBlue": "#427296",
    "terminal.ansiMagenta": "#a440bc",
    "terminal.ansiCyan": "#22777a",
    "terminal.ansiWhite": "#c1c8cc",
    "terminal.ansiBrightBlack": "#506573",
    "terminal.ansiBrightRed": "#df3217",
    "terminal.ansiBrightGreen": "#37863d",
    "terminal.ansiBrightYellow": "#92700e",
    "terminal.ansiBrightBlue": "#0f79c5",
    "terminal.ansiBrightMagenta": "#bf2ae3",
    "terminal.ansiBrightCyan": "#0e8387",
    "terminal.ansiBrightWhite": "#d8e1e7"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#656f73"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#a440bc"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#3a4851"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#3a4851"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#22777a"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#b74b3b"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#816a26"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#22777a"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#427296"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#3a4851"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#a440bc"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#3e7943"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#427296"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#3e7943"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#427296",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#22777a"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#22777a"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#3e7943"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#b74b3b"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#427296"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#b74b3b"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#a440bc",
    "string": "#3a4851",
    "number": "#b74b3b",
    "function": "#22777a",
    "method": "#22777a",
    "type": "#427296",
    "class": "#427296",
    "interface": "#427296",
    "enum": "#427296",
    "enumMember": "#816a26",
    "property": "#3e7943",
    "parameter": "#3a4851",
    "variable": "#3a4851",
    "variable.readonly": "#816a26",
    "*.defaultLibrary": "#427296",
    "comment": "#656f73"
  }
}
