{
  "$schema": "vscode://schemas/color-theme",
  "name": "Clear Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#3a4851",
    "focusBorder": "#487ba2",
    "selection.background": "#e5ecf1",
    "descriptionForeground": "#506573",
    "errorForeground": "#bf4e3d",
    "icon.foreground": "#506573",
    "widget.border": "#dfe2e3",
    "widget.shadow": "#00000020",
    "textLink.foreground": "#487ba2",
    "textLink.activeForeground": "#487ba2",
    "textPreformat.foreground": "#258184",
    "textBlockQuote.background": "#f7f8f8",
    "textCodeBlock.background": "#f7f8f8",
    "scrollbarSlider.background": "#00000000",
    "scrollbarSlider.hoverBackground": "#9ca4a870",
    "scrollbarSlider.activeBackground": "#9ca4a890",
    "titleBar.activeBackground": "#ffffff",
    "titleBar.activeForeground": "#3a4851",
    "titleBar.inactiveBackground": "#ffffff",
    "titleBar.inactiveForeground": "#506573",
    "titleBar.border": "#dfe2e3",
    "activityBar.background": "#ffffff",
    "activityBar.foreground": "#3a4851",
    "activityBar.inactiveForeground": "#506573",
    "activityBar.border": "#dfe2e3",
    "activityBar.activeBorder": "#487ba2",
    "activityBarBadge.background": "#1f7bbc",
    "activityBarBadge.foreground": "#ffffff",
    "sideBar.background": "#ffffff",
    "sideBar.foreground": "#3a4851",
    "sideBar.border": "#dfe2e3",
    "sideBarTitle.foreground": "#506573",
    "sideBarSectionHeader.background": "#ffffff",
    "sideBarSectionHeader.foreground": "#3a4851",
    "sideBarSectionHeader.border": "#dfe2e3",
    "statusBar.background": "#ffffff",
    "statusBar.foreground": "#506573",
    "statusBar.border": "#dfe2e3",
    "statusBar.noFolderBackground": "#ffffff",
    "statusBar.debuggingBackground": "#8c742940",
    "statusBar.debuggingForeground": "#3a4851",
    "statusBarItem.hoverBackground": "#3a485110",
    "statusBarItem.remoteBackground": "#1f7bbc",
    "statusBarItem.remoteForeground": "#ffffff",
    "panel.background": "#ffffff",
    "panel.border": "#dfe2e3",
    "panelTitle.activeForeground": "#3a4851",
    "panelTitle.inactiveForeground": "#506573",
    "panelTitle.activeBorder": "#487ba2",
    "editorGroupHeader.tabsBackground": "#ffffff",
    "editorGroupHeader.tabsBorder": "#dfe2e3",
    "editorGroup.border": "#dfe2e3",
    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#3a4851",
    "tab.activeBorderTop": "#487ba2",
    "tab.inactiveBackground": "#ffffff",
    "tab.inactiveForeground": "#506573",
    "tab.border": "#dfe2e3",
    "tab.hoverBackground": "#3a485110",
    "breadcrumb.foreground": "#506573",
    "breadcrumb.focusForeground": "#3a4851",
    "list.activeSelectionBackground": "#eff0f1",
    "list.activeSelectionForeground": "#3a4851",
    "list.inactiveSelectionBackground": "#eff0f180",
    "list.hoverBackground": "#3a485110",
    "list.focusOutline": "#487ba2",
    "list.highlightForeground": "#487ba2",
    "list.errorForeground": "#bf4e3d",
    "list.warningForeground": "#8c7429",
    "tree.indentGuidesStroke": "#d0d3d5",
    "input.background": "#ffffff",
    "input.foreground": "#3a4851",
    "input.border": "#dfe2e3",
    "input.placeholderForeground": "#506573",
    "inputOption.activeBorder": "#487ba2",
    "inputOption.activeBackground": "#487ba230",
    "dropdown.background": "#ffffff",
    "dropdown.border": "#dfe2e3",
    "button.background": "#1f7bbc",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#1a69a0",
    "button.secondaryBackground": "#edefef",
    "button.secondaryForeground": "#3a4851",
    "badge.background": "#1f7bbc",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#487ba2",
    "checkbox.background": "#ffffff",
    "checkbox.border": "#dfe2e3",
    "editorWidget.background": "#ffffff",
    "editorWidget.border": "#dfe2e3",
    "editorHoverWidget.background": "#ffffff",
    "editorHoverWidget.border": "#dfe2e3",
    "editorSuggestWidget.background": "#ffffff",
    "editorSuggestWidget.border": "#dfe2e3",
    "editorSuggestWidget.selectedBackground": "#eff0f1",
    "editorSuggestWidget.highlightForeground": "#487ba2",
    "quickInput.background": "#ffffff",
    "pickerGroup.foreground": "#487ba2",
    "pickerGroup.border": "#dfe2e3",
    "menu.background": "#ffffff",
    "menu.selectionBackground": "#1f7bbc",
    "menu.selectionForeground": "#ffffff",
    "notifications.background": "#ffffff",
    "notifications.border": "#dfe2e3",
    "editor.background": "#ffffff",
    "editor.foreground": "#3a4851",
    "editorCursor.foreground": "#919191",
    "editorCursor.background": "#ffffff",
    "editor.selectionBackground": "#eff0f1",
    "editor.inactiveSelectionBackground": "#eff0f180",
    "editor.selectionHighlightBackground": "#eff0f180",
    "editor.wordHighlightBackground": "#eff0f160",
    "editor.wordHighlightStrongBackground": "#eff0f190",
    "editor.findMatchBackground": "#8c742928",
    "editor.findMatchBorder": "#8c7429",
    "editor.findMatchHighlightBackground": "#8c742918",
    "editor.findMatchHighlightBorder": "#8c742980",
    "editor.lineHighlightBackground": "#3a48510a",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#b8bdc0",
    "editorLineNumber.activeForeground": "#3a4851",
    "editorIndentGuide.background1": "#edefef",
    "editorIndentGuide.activeBackground1": "#d0d3d5",
    "editorWhitespace.foreground": "#dfe2e3",
    "editorRuler.foreground": "#edefef",
    "editorBracketMatch.background": "#487ba230",
    "editorBracketMatch.border": "#00000000",
    "editorBracketHighlight.foreground1": "#487ba2",
    "editorBracketHighlight.foreground2": "#ac4ec2",
    "editorBracketHighlight.foreground3": "#258184",
    "editorBracketHighlight.foreground4": "#448349",
    "editorBracketHighlight.foreground5": "#8c7429",
    "editorBracketHighlight.foreground6": "#bf4e3d",
    "editorError.foreground": "#bf4e3d",
    "editorWarning.foreground": "#8c7429",
    "editorInfo.foreground": "#487ba2",
    "editorHint.foreground": "#448349",
    "editorLink.activeForeground": "#487ba2",
    "editorGutter.addedBackground": "#448349",
    "editorGutter.modifiedBackground": "#487ba2",
    "editorGutter.deletedBackground": "#bf4e3d",
    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.errorForeground": "#bf4e3d",
    "editorOverviewRuler.warningForeground": "#8c7429",
    "editorOverviewRuler.findMatchForeground": "#8c7429",
    "diffEditor.insertedTextBackground": "#44834930",
    "diffEditor.removedTextBackground": "#bf4e3d30",
    "diffEditor.insertedLineBackground": "#44834918",
    "diffEditor.removedLineBackground": "#bf4e3d18",
    "gitDecoration.addedResourceForeground": "#448349",
    "gitDecoration.untrackedResourceForeground": "#448349",
    "gitDecoration.modifiedResourceForeground": "#487ba2",
    "gitDecoration.deletedResourceForeground": "#bf4e3d",
    "gitDecoration.conflictingResourceForeground": "#ac4ec2",
    "gitDecoration.ignoredResourceForeground": "#506573",
    "terminal.background": "#ffffff",
    "terminal.foreground": "#3a4851",
    "terminalCursor.foreground": "#919191",
    "terminalCursor.background": "#ffffff",
    "terminal.selectionBackground": "#e5ecf1",
    "terminal.ansiBlack": "#2d3840",
    "terminal.ansiRed": "#b45648",
    "terminal.ansiGreen": "#6caa71",
    "terminal.ansiYellow": "#c4ac62",
    "terminal.ansiBlue": "#5685a8",
    "terminal.ansiMagenta": "#ad64be",
    "terminal.ansiCyan": "#69c6c9",
    "terminal.ansiWhite": "#c1c8cc",
    "terminal.ansiBrightBlack": "#506573",
    "terminal.ansiBrightRed": "#df6c5a",
    "terminal.ansiBrightGreen": "#79be7e",
    "terminal.ansiBrightYellow": "#e5c872",
    "terminal.ansiBrightBlue": "#49a2e1",
    "terminal.ansiBrightMagenta": "#d389e5",
    "terminal.ansiBrightCyan": "#77e1e5",
    "terminal.ansiBrightWhite": "#d8e1e7"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6e787d"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#ac4ec2"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#3a4851"
      }
    },
    {
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#3a4851"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#258184"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#bf4e3d"
      }
    },
    {
      "scope": [
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#8c7429"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#258184"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#487ba2"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#3a4851"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#ac4ec2"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#448349"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#487ba2"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#448349"
      }
    },
    {
      "scope": [
        "entity.name.section",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#487ba2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#258184"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#258184"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#448349"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#bf4e3d"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#487ba2"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#bf4e3d"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#ac4ec2",
    "string": "#3a4851",
    "number": "#bf4e3d",
    "function": "#258184",
    "method": "#258184",
    "type": "#487ba2",
    "class": "#487ba2",
    "interface": "#487ba2",
    "enum": "#487ba2",
    "enumMember": "#8c7429",
    "property": "#448349",
    "parameter": "#3a4851",
    "variable": "#3a4851",
    "variable.readonly": "#8c7429",
    "*.defaultLibrary": "#487ba2",
    "comment": "#6e787d"
  }
}
