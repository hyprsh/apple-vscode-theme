{
  "name": "clear-theme",
  "displayName": "Clear Theme",
  "description": "macOS Terminal's Clear Dark and Clear Light, plus Ghostty's Apple System Colors.",
  "version": "0.1.0",
  "publisher": "hyprsh",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Clear Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/clear-dark.json"
      },
      {
        "label": "Clear Light",
        "uiTheme": "vs",
        "path": "./themes/clear-light.json"
      },
      {
        "label": "Apple System Colors",
        "uiTheme": "vs-dark",
        "path": "./themes/apple-system-colors-dark.json"
      },
      {
        "label": "Apple System Colors Light",
        "uiTheme": "vs",
        "path": "./themes/apple-system-colors-light.json"
      }
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyprsh/clear-theme"
  }
}
